{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Antiforgery": "Error",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/syncapp-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 80,
          "retainedFileTimeLimit": "10.00:00:00",
          "shared": true,
          "flushToDiskInterval": "00:00:05",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errors/error-.log",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 20,
          "retainedFileTimeLimit": "10.00:00:00",
          "shared": true,
          "flushToDiskInterval": "00:00:05",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../SyncApp26.Infrastructure/SyncApp26.db;Mode=ReadWrite"
  },
  "Logging": {
    "Redaction": {
      "Enabled": true,
      "RedactGuids": true,
      "MaskEmails": true,
      "MaskIpAddresses": true,
      "SanitizeControlCharacters": true,
      "MaxStringLength": 2048
    }
  },
  "LogRetention": {
    "SweepIntervalMinutes": 60,
    "RetentionDays": 10,
    "Directories": [
      { "Path": "logs", "MaxFilesPerDay": 8 },
      { "Path": "logs/errors", "MaxFilesPerDay": 2 }
    ]
  },
  "AllowedHosts": "*",
  "Frontend": {
    "LoginUrl": "http://localhost:4200/login"
  },
  "Localization": {
    "SupportedLanguages": [ "En", "Ro" ],
    "DefaultLanguage": "En"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-smtp-app-password",
    "FromEmail": "syncapp@hr.com",
    "FromName": "SyncApp26",
    "EnableSsl": true
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY",
    "Issuer": "SyncApp26API",
    "Audience": "SyncApp26Client",
    "ExpirationMinutes": 60
  },
  "SignatureHmac": {
    "DevKey": "REPLACE_WITH_A_LONG_RANDOM_DEV_ONLY_KEY"
  },
  "SignatureVerificationSweep": {
    "Enabled": true,
    "IntervalHours": 24
  },
  "Authentication": {
    "Google": {
      "ClientId": "REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
    },
    "Microsoft": {
      "ClientId": "REPLACE_WITH_YOUR_MICROSOFT_ENTRA_APPLICATION_CLIENT_ID"
    }
  }
}

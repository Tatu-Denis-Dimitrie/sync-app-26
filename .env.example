# Copy this file to .env at the repo root and fill in real values. .env is git-ignored.
# Everything here maps 1:1 onto SyncApp26.API/appsettings.example.json via ASP.NET Core's
# "Section__Key" environment-variable convention.
#
# Not listed here (defined directly in docker-compose.yml instead, as fixed topology constants,
# not secrets): ConnectionStrings__DefaultConnection, Auth__Cookie__Secure.

# --- Host port mapping ---
FRONTEND_PORT=8080

# --- ASP.NET Core environment ---
# Production hides Swagger. Auth__Cookie__Secure is forced to false in docker-compose.yml
# regardless, since this stack has no TLS termination.
ASPNETCORE_ENVIRONMENT=Production

# --- JWT (required — the API throws at startup if this is missing) ---
JwtSettings__SecretKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=SyncApp26API
JwtSettings__Audience=SyncApp26Client
JwtSettings__ExpirationMinutes=60

# --- SMTP (verification, password reset, and signature-request emails) ---
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your-email@gmail.com
Smtp__Password=REPLACE_WITH_YOUR_SMTP_APP_PASSWORD
Smtp__FromEmail=syncapp@yourcompany.com
Smtp__FromName=SyncApp26
Smtp__EnableSsl=true

# --- OAuth client IDs (Google/Microsoft sign-in) ---
Authentication__Google__ClientId=REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
Authentication__Microsoft__ClientId=REPLACE_WITH_YOUR_MICROSOFT_ENTRA_APPLICATION_CLIENT_ID

# --- Document-signature HMAC key ---
SignatureHmac__DevKey=REPLACE_WITH_A_LONG_RANDOM_KEY

# --- Frontend links embedded in emails ---
Frontend__BaseUrl=http://localhost:8080
Frontend__LoginUrl=http://localhost:8080/login
Frontend__ResetPasswordUrl=http://localhost:8080/reset-password
